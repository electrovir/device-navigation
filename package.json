{
    "name": "device-navigation",
    "version": "4.7.1",
    "description": "Navigate HTML elements in two dimensions with non-pointer devices.",
    "keywords": [
        "keyboard",
        "navigation",
        "mouse",
        "focus",
        "accessibility",
        "gamepad",
        "frontend",
        "ui",
        "elements"
    ],
    "homepage": "https://github.com/electrovir/device-navigation",
    "bugs": {
        "url": "https://github.com/electrovir/device-navigation/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/device-navigation.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build && npm run docs && cp -r dist-docs dist-frontend/docs",
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.73.0",
        "@augment-vir/common": "^31.73.0",
        "@augment-vir/web": "^31.73.0",
        "type-fest": "^5.7.0",
        "typed-event-target": "^4.3.1"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.73.0",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@web/dev-server-esbuild": "^1.0.5",
        "@web/test-runner": "^0.20.2",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.1",
        "@web/test-runner-visual-regression": "^0.10.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^17.4.3",
        "element-vir": "^26.17.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.0.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.4",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^65.0.1",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.5",
        "npm-check-updates": "^22.2.3",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.2",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
