{
    "name": "device-navigation",
    "version": "4.1.2",
    "description": "Navigate HTML elements in two dimensions with non-pointer devices.",
    "keywords": [
        "keyboard",
        "navigation",
        "mouse",
        "focus",
        "accessibility",
        "gamepad",
        "frontend",
        "ui",
        "elements"
    ],
    "homepage": "https://github.com/electrovir/device-navigation",
    "bugs": {
        "url": "https://github.com/electrovir/device-navigation/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/device-navigation.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build && npm run docs && cp -r dist-docs dist-frontend/docs",
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.18.0",
        "@augment-vir/common": "^31.18.0",
        "@augment-vir/web": "^31.18.0",
        "type-fest": "^4.41.0",
        "typed-event-target": "^4.0.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.18.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.26.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@web/dev-server-esbuild": "^1.0.4",
        "@web/test-runner": "^0.20.1",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.0",
        "@web/test-runner-visual-regression": "^0.10.0",
        "cspell": "^9.0.1",
        "dependency-cruiser": "^16.10.2",
        "element-vir": "^25.3.0",
        "esbuild": "^0.25.4",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsdoc": "^50.6.14",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.12",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.5",
        "typedoc": "^0.28.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "virmator": "^13.15.1",
        "vite": "^6.3.5",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "peerDependencies": {
